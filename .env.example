# Copy to .env and fill in. .env is git-ignored (never committed).
# For local dev, this file documents what a fresh checkout needs.

# Required for enrich / themes / ask / chat / serve.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown).
# PORT=8787
# NEWS_DB=data/news.db
# NEWS_REFRESH_MINUTES=0          # >0 = background ingest+enrich+re-theme loop
# NEWS_SOURCE_LIMIT=40
# NEWS_ENRICH_MODEL=claude-sonnet-5
# NEWS_THEME_MODEL=claude-sonnet-5
# NEWS_ASK_MODEL=claude-opus-5
